# Rode `npx supabase start` e copie Publishable de `npx supabase status`.
# Sem aspas nos valores.

# iOS Simulator ou app/web na mesma máquina do Docker:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Emulador Android (10.0.2.2 = host a partir do emulador):
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321

# Celular físico (Expo Go ou dev build) na mesma Wi‑Fi — IP da máquina na rede:
# EXPO_PUBLIC_SUPABASE_URL=http://<IP-da-sua-máquina>:54321

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
